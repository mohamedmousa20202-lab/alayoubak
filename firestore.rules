rules_version = '2';
// ============================================================
//  قواعد الأمان لمنصة أ / محمد موسى
//  ⚠️ غيّر البريد في السطر التالي إلى بريدك أنت (نفس البريد في config.js)
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function teacherEmail() { return 'mohamedmousa20202@gmail.com'; }

    function signedIn()  { return request.auth != null; }
    function isTeacher() { return signedIn() && request.auth.token.email == teacherEmail(); }
    function uid()       { return request.auth.uid; }
    function studentPath(id) { return /databases/$(database)/documents/students/$(id); }
    // طالب مسجَّل من قِبل المعلم وحسابه مفعّل
    function isStudent() {
      return signedIn() && exists(studentPath(uid())) && get(studentPath(uid())).data.active == true;
    }
    function quizDoc(qid) { return get(/databases/$(database)/documents/quizzes/$(qid)).data; }
    // الاختبار المؤقت: يجب أن يكون الطالب قد بدأه، وأن يسلّم قبل انتهاء الزمن (+ دقيقتان سماح)
    function withinTime(qid) {
      return quizDoc(qid).get('timeLimit', 0) == 0
        || (exists(/databases/$(database)/documents/starts/$(qid + '_' + uid()))
            && request.time <= get(/databases/$(database)/documents/starts/$(qid + '_' + uid())).data.startedAt
                               + duration.value(quizDoc(qid).get('timeLimit', 0) + 2, 'm'));
    }
    function keysOnly(list) { return request.resource.data.keys().hasOnly(list); }
    function changedOnly(list) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(list); }

    // ---------- الطلاب ----------
    match /students/{sid} {
      allow read: if isTeacher() || (signedIn() && sid == uid());
      allow delete: if isTeacher();
      // التسجيل الذاتي: الطالب ينشئ ملفه مرة واحدة، ويبقى موقوفاً حتى يوافق المعلم
      allow create: if isTeacher()
        || (signedIn() && sid == uid() && !isTeacher()
            && keysOnly(['name', 'className', 'email', 'active', 'status', 'createdAt'])
            && request.resource.data.active == false
            && request.resource.data.status == 'pending'
            && request.resource.data.createdAt == request.time
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 60
            && request.resource.data.className is string && request.resource.data.className.size() <= 40
            && request.resource.data.email == request.auth.token.email);
      allow update: if isTeacher()
        || (isStudent() && sid == uid() && changedOnly(['lastLogin']) && request.resource.data.lastLogin == request.time);
    }

    // كلمات المرور المحفوظة – للمعلم فقط
    match /credentials/{sid} {
      allow read, write: if isTeacher();
    }

    // ---------- الدروس / الإعلانات / الواجبات ----------
    match /lessons/{id} {
      allow read: if isTeacher() || (isStudent() && resource.data.published == true);
      allow write: if isTeacher();
    }
    match /announcements/{id} {
      allow read: if isTeacher() || isStudent();
      allow write: if isTeacher();
    }
    match /assignments/{id} {
      allow read: if isTeacher() || (isStudent() && resource.data.published == true);
      allow write: if isTeacher();
    }

    // فهرس المحتوى المنشور (يبنيه المعلم تلقائياً عند كل حفظ)
    match /meta/{id} {
      allow read: if isTeacher() || isStudent();
      allow write: if isTeacher();
    }

    // بنك الأسئلة والمختبر: يراه الطالب إذا نُشر
    match /banks/{id} {
      allow read: if isTeacher() || (isStudent() && resource.data.published == true);
      allow write: if isTeacher();
    }
    match /labs/{id} {
      allow read: if isTeacher() || (isStudent() && resource.data.published == true);
      allow write: if isTeacher();
    }
    // مواعيد التقويم
    match /events/{id} {
      allow read: if isTeacher() || isStudent();
      allow write: if isTeacher();
    }
    // الحضور: للمعلم فقط
    match /attendance/{id} {
      allow read, write: if isTeacher();
    }

    // ---------- الاختبارات ----------
    // الأسئلة بدون الإجابات
    match /quizzes/{qid} {
      allow read: if isTeacher() || (isStudent() && resource.data.published == true);
      allow write: if isTeacher();
    }
    // مفتاح الإجابات: لا يراه الطالب إلا بعد التسليم وإذا سمح المعلم بعرض النتائج
    match /quizKeys/{qid} {
      allow read: if isTeacher()
        || (isStudent()
            && exists(/databases/$(database)/documents/submissions/$(qid + '_' + uid()))
            && get(/databases/$(database)/documents/quizzes/$(qid)).data.showResults == true);
      allow write: if isTeacher();
    }
    // تسليمات الاختبارات: مرة واحدة فقط، ولا يمكن للطالب تعديلها.
    // الطالب يرسل إجاباته فقط؛ الدرجة يحسبها المنصة عند المعلم من مفتاح الإجابات.
    match /submissions/{subId} {
      allow read: if isTeacher() || (isStudent() && (resource == null || resource.data.studentId == uid()));
      allow create: if isStudent()
        && keysOnly(['quizId', 'studentId', 'className', 'picks', 'scored', 'submittedAt'])
        && request.resource.data.studentId == uid()
        && request.resource.data.className == get(studentPath(uid())).data.className
        && subId == request.resource.data.quizId + '_' + uid()
        && request.resource.data.picks is map
        && request.resource.data.picks.size() <= 200
        && request.resource.data.scored == false
        && request.resource.data.submittedAt == request.time
        && quizDoc(request.resource.data.quizId).published == true
        && quizDoc(request.resource.data.quizId).open == true
        && withinTime(request.resource.data.quizId);
      allow update, delete: if isTeacher();   // الاحتساب، أو السماح بإعادة الحل
    }

    // وقت بدء الاختبار لكل طالب (لمنع التسليم بعد انتهاء الزمن)
    match /starts/{sid} {
      allow read: if isTeacher() || (isStudent() && (resource == null || resource.data.studentId == uid()));
      allow create: if isStudent()
        && keysOnly(['quizId', 'studentId', 'startedAt'])
        && request.resource.data.studentId == uid()
        && sid == request.resource.data.quizId + '_' + uid()
        && request.resource.data.startedAt == request.time
        && quizDoc(request.resource.data.quizId).published == true
        && quizDoc(request.resource.data.quizId).open == true;
      allow update: if false;
      allow delete: if isTeacher();
    }

    // ---------- مشاهدات الدروس (للمتابعة) ----------
    match /views/{vid} {
      allow read: if isTeacher() || (isStudent() && (resource == null || resource.data.studentId == uid()));
      allow create: if isStudent()
        && keysOnly(['lessonId', 'studentId', 'viewedAt', 'counted'])
        && request.resource.data.studentId == uid()
        && vid == request.resource.data.lessonId + '_' + uid()
        && request.resource.data.counted == false
        && request.resource.data.viewedAt == request.time;
      allow update, delete: if isTeacher();
    }

    // ---------- تسليم الواجبات ----------
    match /homework/{hid} {
      allow read: if isTeacher() || (isStudent() && (resource == null || resource.data.studentId == uid()));
      allow create: if isStudent()
        && keysOnly(['assignmentId', 'studentId', 'text', 'link', 'files', 'submittedAt', 'graded', 'counted'])
        && request.resource.data.studentId == uid()
        && hid == request.resource.data.assignmentId + '_' + uid()
        && request.resource.data.graded == false && request.resource.data.counted == false
        && hwTextOk()
        && get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data.published == true;
      // يعدّل الطالب تسليمه ما دام المعلم لم يصححه بعد
      allow update: if isTeacher()
        || (isStudent() && resource.data.studentId == uid()
            && resource.data.graded == false
            && changedOnly(['text', 'link', 'files', 'submittedAt'])
            && hwTextOk());
      allow delete: if isTeacher();
      function hwTextOk() {
        return request.resource.data.text is string && request.resource.data.text.size() <= 5000
          && request.resource.data.link is string && request.resource.data.link.size() <= 500
          && request.resource.data.submittedAt == request.time
          && (!('files' in request.resource.data) || (request.resource.data.files is list && request.resource.data.files.size() <= 5));
      }
    }

    // ---------- الرسائل الخاصة (طالب ↔ معلم) ----------
    // teacherUnread / studentUnread: علامة «رسالة جديدة» لكل طرف
    match /threads/{sid} {
      allow read: if isTeacher() || (isStudent() && sid == uid());
      allow create: if isTeacher()
        || (isStudent() && sid == uid()
            && keysOnly(['lastAt', 'lastFrom', 'lastText', 'teacherUnread'])
            && studentLastOk());
      allow update: if isTeacher()
        || (isStudent() && sid == uid()
            && changedOnly(['lastAt', 'lastFrom', 'lastText', 'teacherUnread', 'studentUnread'])
            && request.resource.data.get('studentUnread', false) == false
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastAt', 'lastFrom', 'lastText', 'teacherUnread'])
                || studentLastOk()));
      allow delete: if isTeacher();
      function studentLastOk() {
        return request.resource.data.lastFrom == 'student'
          && request.resource.data.teacherUnread == true
          && request.resource.data.lastAt == request.time
          && request.resource.data.lastText is string && request.resource.data.lastText.size() <= 120;
      }
      match /msgs/{mid} {
        allow read: if isTeacher() || (isStudent() && sid == uid());
        allow create: if isTeacher()
          || (isStudent() && sid == uid()
              && keysOnly(['from', 'text', 'at'])
              && request.resource.data.from == 'student'
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
              && request.resource.data.at == request.time);
        allow update, delete: if isTeacher();
      }
    }

    // ---------- الملفات المرفوعة من الكمبيوتر (تُحفظ على أجزاء) ----------
    // ملفات المعلم (shared) يراها كل طالب مفعّل؛ ملف الطالب يراه هو والمعلم فقط
    function fileOk(f) { return f.shared == true || f.owner == uid(); }
    match /files/{fid} {
      allow read: if isTeacher() || (isStudent() && fileOk(resource.data));
      allow create: if isTeacher()
        || (isStudent()
            && keysOnly(['name', 'type', 'size', 'parts', 'owner', 'shared', 'createdAt'])
            && request.resource.data.owner == uid()
            && request.resource.data.shared == false
            && request.resource.data.name is string && request.resource.data.name.size() <= 200
            && request.resource.data.type is string && request.resource.data.type.size() <= 100
            && request.resource.data.size is int && request.resource.data.size <= 5242880
            && request.resource.data.parts is int && request.resource.data.parts >= 1 && request.resource.data.parts <= 6
            && request.resource.data.createdAt == request.time);
      allow update, delete: if isTeacher();
    }
    match /fileParts/{pid} {
      allow read: if isTeacher()
        || (isStudent() && fileOk(get(/databases/$(database)/documents/files/$(resource.data.fileId)).data));
      allow create: if isTeacher()
        || (isStudent()
            && keysOnly(['fileId', 'i', 'data'])
            && request.resource.data.i is int
            && pid == request.resource.data.fileId + '_' + string(request.resource.data.i)
            && request.resource.data.data is bytes && request.resource.data.data.size() <= 950000
            && get(/databases/$(database)/documents/files/$(request.resource.data.fileId)).data.owner == uid()
            && request.resource.data.i < get(/databases/$(database)/documents/files/$(request.resource.data.fileId)).data.parts);
      allow update, delete: if isTeacher();
    }

    // أي شيء آخر ممنوع
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
